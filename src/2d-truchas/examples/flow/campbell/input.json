// Nondimensional dam-break flow benchmark of Martin and Moyce.  A 1 by 2
// fluid column initially occupies the left side of a 5 by 3 domain; the
// remainder is VOID.  Gravity acts downward, the walls are free-slip, and
// the top boundary has zero pressure.  This is a long-running example for
// visual and benchmark studies, rather than a routine CTest regression.
{
  "materials": {
    "Al_liq": {
      "properties": {
        "fluid": true,
        "density": 2400.0,
        "viscosity": 0.02
      }
    }
  },
  "material-regions": {
    "refinement-level": 0,
    "fluid-column": {
      "material": "Al_liq",
      "type": "box",
      "lower-corner": [0.0,  400.0e-3],
      "upper-corner": [20.0e-3, 410.0e-3]
    },
    "void-background": {
      "material": "VOID",
      "type": "background"
    }
  },
  "mesh": {
    "mesh-file": "mesh-1.25.gen",
    "coord-scale-factor": 0.001
  },
  "flow-model": {
    "inviscid": false,
    "body-acceleration": [0.0, -9.81],
    "void-collapse": {"pressure-time-scale": 1.0, "reaction-cap": 100.0},
    "bc": {
      "inlet": {"type": "pressure", "pressure": 1000.0, "face-set-ids": [1]},
      "walls": {"type": "no-slip", "face-set-ids": [2]}
    }
  },
  "flow-solver": {
    "courant-number": 0.2,
    "volume-tracking": {"algorithm": "geometric", "cutoff": 1.0e-6},
    "projection-solver": {"rel-tol": 1.0e-10, "max-ds-iter": 100, "max-amg-iter": 100},
    "momentum-solver": {"rel-tol": 1.0e-10, "max-ds-iter": 100, "max-amg-iter": 100}
  },
  "initial-time": 0.0,
  "output-times": {"times": [0.0, 2.5], "subintervals": [50]},
  "time-stepping": {
    "initial-time-step": 1.0e-3,
    "min-time-step": 1.0e-6,
    "max-time-step": 1.0,
    "time-step-growth": 1.05
  },
  "initial-velocity": [0.0, 0.0]
}
