// Lid-driven cavity benchmark at Reynolds number 1000.
//
// This is the nondimensional unit-square problem of Ghia, Ghia, and Shin,
// "High-Re Solutions for Incompressible Flow Using the Navier-Stokes
// Equations and a Multigrid Method," J. Comput. Phys. 48 (1982), 387-411.
// The fluid is initially at rest; the upper lid moves with unit velocity and
// the remaining walls are no-slip. With density and length scales equal to
// one, viscosity=1e-3 gives Re=1000.
{
  "materials": {
    "fluid": {
      "properties": {
        "fluid": true,
        "density": 1.0,
        "viscosity": 1.0e-3
      }
    }
  },
  "mesh": {
    "x-axis": {"coarse-grid": [0.0, 1.0], "intervals": [129]},
    "y-axis": {"coarse-grid": [0.0, 1.0], "intervals": [129]}
  },
  "flow-model": {
    "bc": {
      "lid": {"type": "velocity", "velocity": [1.0, 0.0], "face-set-ids": [4]},
      "walls": {"type": "no-slip", "face-set-ids": [1, 2, 3]}
    }
  },
  "flow-solver": {
    "courant-number": 0.5,
    "projection-solver": {"rel-tol": 1.0e-8, "max-ds-iter": 100, "max-amg-iter": 100, "amg-strong-threshold": 0.25},
    "momentum-solver": {"rel-tol": 1.0e-8, "max-ds-iter": 100, "max-amg-iter": 100}
  },
  "initial-time": 0.0,
  "output-times": {"times": [0.0, 40.0], "subintervals": [8]},
  "time-stepping": {
    "initial-time-step": 1.0e-3,
    "min-time-step": 1.0e-5,
    "max-time-step": 1.0,
    "time-step-growth": 1.05
  },
  "initial-velocity": [0.0, 0.0]
}
