// Two-fluid isothermal hydrostatic column: heavy fluid below y=0.5 and
// light fluid above it, with a downward body acceleration.  This regression
// checks the piecewise hydrostatic pressure, material distribution, and zero
// velocity over time.
{
    "materials": {
        "light-liquid": {
            "properties": {
                "fluid": true,
                "density": 1.0
            }
        },
        "heavy-liquid": {
            "properties": {
                "fluid": true,
                "density": 2.0
            }
        }
    },
    "material-regions": {
        "bottom-layer": {
            "material": "heavy-liquid",
            "type": "half-plane",
            "point": [0.0, 0.5],
            "normal": [0.0, 1.0]
        },
        "top-layer": {"material": "light-liquid", "type": "background"}
    },
    "mesh": {
        "x-axis": {"coarse-grid": [0.0, 1.0], "intervals": [16]},
        "y-axis": {"coarse-grid": [0.0, 1.0], "intervals": [16]}
    },
    "flow-model": {
        "inviscid": true,
        "body-acceleration": [0.0, 1.0],
        "bc": {
            "walls": {"type": "free-slip", "face-set-ids": [1, 2, 4]},
            "reference-pressure": {"type": "pressure", "face-set-ids": [3], "pressure": 0.0}
        }
    },
    "flow-solver": {
        "courant-number": 0.5,
        "volume-tracking": {"algorithm": "geometric"},
        "projection-solver": {"rel-tol": 1.0e-10, "max-ds-iter": 100, "max-amg-iter": 100}
    },
    "sim-control": {
        "initial-time": 0.0,
        "initial-time-step": 1.0e-2,
        "min-time-step": 1.0e-8,
        "max-time-step": 1.0e-2,
        "time-step-growth": 1.05,
        "output-times": [0.1]
    },
    "initial-velocity": [0.0, 0.0]
}
