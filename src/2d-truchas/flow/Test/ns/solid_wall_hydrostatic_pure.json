// Hydrostatic fluid beside a SOLID vertical wall and above a SOLID floor.
// The material interfaces coincide with mesh faces in this pure-cell case.
{
    "materials": {
        "wall": {"properties": {"density": 2.0}},
        "fluid": {"properties": {"fluid": true, "density": 2.0}}
    },
    "material-regions": {
        "left-wall": {
            "material": "wall", "type": "box",
            "lower-corner": [0.0, 0.0], "upper-corner": [0.25, 1.0]
        },
        "floor": {
            "material": "wall", "type": "box",
            "lower-corner": [0.25, 0.0], "upper-corner": [1.0, 0.25]
        },
        "fluid-domain": {"material": "fluid", "type": "background"}
    },
    "mesh": {
        "x-axis": {"coarse-grid": [0.0, 1.0], "intervals": [16]},
        "y-axis": {"coarse-grid": [0.0, 1.0], "intervals": [16]}
    },
    "flow-model": {
        "inviscid": true,
        "body-acceleration": [0.0, -1.0],
        "bc": {
            "right-wall": {"type": "free-slip", "face-set-ids": [2]},
            "pressure-reference": {"type": "pressure", "face-set-ids": [4], "pressure": 0.0}
        }
    },
    "flow-solver": {
        "courant-number": 0.5,
        "volume-tracking": {"algorithm": "simple"},
        "projection-solver": {"rel-tol": 1.0e-10, "max-ds-iter": 100, "max-amg-iter": 100}
    },
    "initial-velocity": [0.0, 0.0],
    "sim-control": {
        "initial-time": 0.0, "initial-time-step": 1.0e-2,
        "min-time-step": 1.0e-8, "max-time-step": 1.0e-2,
        "output-times": [1.0]
    }
}
