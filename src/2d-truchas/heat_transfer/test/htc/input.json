{
    "materials": {
        "default": {
            "properties": {
                "conductivity": 1.0,
                "density": 1.0,
                "specific-heat": 1.0
            }
        }
    },
    "mesh": {
        "x-axis": {"coarse-grid": [0.0, 1.0], "intervals": [8]},
        "y-axis": {"coarse-grid": [0.0, 1.0], "intervals": [8]}
    },
    "ht-model": {
        "bc": {
            "all-sides": {
                "type": "htc",
                "face-set-ids": [1, 2, 3, 4],
                "htc": 1.0,
                "ambient-temp": 0.0
            }
        }
    },
    "ht-solver": {
        "preconditioner": {
            "method": "BoomerAMG",
            "params": {"num-cycles": 1}
        },
        "error-norm": {
            "abs-t-tol": 1.0e-10,
            "rel-t-tol": 1.0e-6,
            "rel-h-tol": 1.0e-6
        },
        "integrator": {
            "nlk-max-iter": 10,
            "nlk-tol": 0.01
        }
    },
    "sim-control": {
        "initial-time": 0.0,
        "initial-time-step": 1.0e-3,
        "min-time-step": 1.0e-6,
        "output-times": [0.01]
    },
    "initial-temperature": {
        "type": "constant",
        "value": 1.0
    }
}
