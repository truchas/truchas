{
    "materials": {
        "fluid": {
            "properties": {
                "fluid": true,
                "conductivity": 1.0,
                "density": 1.0,
                "specific-heat": 1.0,
                "viscosity": 1.0,
                "thermal-expan-coef": 0.5,
                "expan-ref-temp": 0.0
            }
        }
    },
    "mesh": {
        "x-axis": {"coarse-grid": [0.0, 1.0], "intervals": [49]},
        "y-axis": {"coarse-grid": [0.0, 1.0], "intervals": [49]}
    },
    "flow-model": {
        "body-acceleration": [0.0, 1.0],
        "bc": {
            "walls": {"type": "free-slip", "face-set-ids": [1, 2, 4]},
            "top-pressure": {"type": "pressure", "face-set-ids": [3], "pressure": 0.0}
        }
    },
    "ht-model": {
        "bc": {
            "top": {"type": "temperature", "face-set-ids": [3], "temp": 1.0},
            "bottom": {"type": "temperature", "face-set-ids": [4], "temp": 0.0},
            "sides": {"type": "flux", "face-set-ids": [1, 2], "flux": 0.0}
        },
        "source": {}
    },
    "solver": {
        "flow": {
            "courant-number": 0.5,
            "momentum-solver": {"rel-tol": 1.0e-10, "abs-tol": 1.0e-12,
                "max-ds-iter": 50, "max-amg-iter": 25},
            "projection-solver": {"rel-tol": 0.0, "abs-tol": 1.0e-12,
                "max-ds-iter": 50, "max-amg-iter": 25}
        },
        "thermal": {
            "preconditioner": {"method": "BoomerAMG", "params": {"num-cycles": 1}},
            "error-norm": {"abs-t-tol": 1.0e-10, "rel-t-tol": 1.0e-8,
                "abs-h-tol": 1.0e-10, "rel-h-tol": 1.0e-8},
            "integrator": {"use-backward-euler": true, "nlk-max-iter": 10, "nlk-tol": 0.01}
        },
        "initial-time-step": 1.0e-2,
        "min-time-step": 1.0e-5,
        "max-time-step": 1.0e3,
        "time-step-growth": 1.05
    },
    "sim-control": {"initial-time": 0.0, "output-times": [1.0]},
    "initial-temperature": {
        "type": "polynomial",
        "poly-coef": [1.0, -1.0],
        "poly-powers": [[0, 0], [0, 1]]
    },
    "initial-velocity": [0.0, 0.0]
}
