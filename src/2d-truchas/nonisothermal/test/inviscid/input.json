{
    "materials": {
        "liquid": {
            "properties": {
                "fluid": true,
                "conductivity": 0.0,
                "density": 1.0,
                "specific-heat": 1.0,
                "thermal-expan-coef": 0.0,
                "expan-ref-temp": 0.0
            }
        }
    },
    "mesh": {
        "x-axis": {"coarse-grid": [0.0, 1.0], "intervals": [16]},
        "y-axis": {"coarse-grid": [0.0, 1.0], "intervals": [8]}
    },
    "flow-model": {
        "inviscid": true,
        "bc": {
            "inlet": {"type": "velocity", "face-set-ids": [1], "velocity": [1.0, 0.0]},
            "outlet": {"type": "pressure", "face-set-ids": [2], "pressure": 0.0},
            "walls": {"type": "free-slip", "face-set-ids": [3, 4]}
        }
    },
    "ht-model": {
        "bc": {
            "inlet": {"type": "inflow", "face-set-ids": [1], "temp": 3.0},
            "outlet": {"type": "outflow", "face-set-ids": [2]},
            "walls": {"type": "flux", "face-set-ids": [3, 4], "flux": 0.0}
        },
        "source": {}
    },
    "solver": {
        "flow": {
            "projection-solver": {"rel-tol": 1.0e-10, "max-ds-iter": 100, "max-amg-iter": 100}
        },
        "thermal": {
            "preconditioner": {"method": "BoomerAMG", "params": {"num-cycles": 1}},
            "error-norm": {"abs-t-tol": 1.0e-10, "rel-t-tol": 1.0e-6, "rel-h-tol": 1.0e-6},
            "integrator": {"nlk-max-iter": 10, "nlk-tol": 0.01}
        },
        "initial-time-step": 1.0e-3,
        "min-time-step": 1.0e-8,
        "max-time-step": 1.0e-3,
        "time-step-growth": 1.05,
        "courant-number": 0.5
    },
    "sim-control": {"initial-time": 0.0, "output-times": [0.01]},
    "initial-velocity": [1.0, 0.0],
    "initial-temperature": 2.0
}
