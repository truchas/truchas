// Two-fluid hydrostatic column with a hot top (y=0), cold bottom (y=1), and
// thermal expansion in both fluids.  This regression checks the linear
// temperature profile, the piecewise pressure with its buoyancy-induced
// parabolic component, and zero velocity over time.
{
    "materials": {
        "light-liquid": {
            "properties": {
                "fluid": true,
                "conductivity": 1.0,
                "density": 1.0,
                "specific-heat": 1.0,
                "thermal-expan-coef": 0.9,
                "expan-ref-temp": 0.0
            }
        },
        "heavy-liquid": {
            "properties": {
                "fluid": true,
                "conductivity": 1.0,
                "density": 2.0,
                "specific-heat": 1.0,
                "thermal-expan-coef": 0.9,
                "expan-ref-temp": 0.0
            }
        }
    },
    "material-regions": {
        "bottom-layer": {
            "material": "heavy-liquid",
            "type": "half-plane",
            "point": [0.0, 0.5],
            "normal": [0.0, 1.0]
        },
        "top-layer": {"material": "light-liquid", "type": "background"}
    },
    "mesh": {
        "x-axis": {"coarse-grid": [0.0, 1.0], "intervals": [16]},
        "y-axis": {"coarse-grid": [0.0, 1.0], "intervals": [16]}
    },
    "flow-model": {
        "inviscid": true,
        "body-acceleration": [0.0, 1.0],
        "bc": {
            "walls": {"type": "free-slip", "face-set-ids": [1, 2, 4]},
            "reference-pressure": {"type": "pressure", "face-set-ids": [3], "pressure": 0.0}
        }
    },
    "ht-model": {
        "bc": {
            "top": {"type": "temperature", "face-set-ids": [3], "temp": 1.0},
            "bottom": {"type": "temperature", "face-set-ids": [4], "temp": 0.0},
            "sides": {"type": "flux", "face-set-ids": [1, 2], "flux": 0.0}
        },
        "source": {}
    },
    "solver": {
        "flow": {
            "volume-tracking": {"algorithm": "geometric"},
            "projection-solver": {"rel-tol": 1.0e-10, "max-ds-iter": 100, "max-amg-iter": 100}
        },
        "thermal": {
            "preconditioner": {"method": "BoomerAMG", "params": {"num-cycles": 1}},
            "error-norm": {"abs-t-tol": 1.0e-10, "rel-t-tol": 1.0e-6, "rel-h-tol": 1.0e-6},
            "integrator": {"use-backward-euler": true, "nlk-max-iter": 10, "nlk-tol": 0.01}
        },
        "initial-time-step": 1.0e-2,
        "min-time-step": 1.0e-8,
        "max-time-step": 1.0e-2,
        "time-step-growth": 1.05,
        "courant-number": 0.5
    },
    "sim-control": {"initial-time": 0.0, "output-times": [0.1]},
    "initial-temperature": {
        "type": "polynomial",
        "poly-coef": [1.0, -1.0],
        "poly-powers": [[0, 0], [0, 1]]
    },
    "initial-velocity": [0.0, 0.0]
}
