{
    "materials": {
        "inlet-liquid": {
            "properties": {
                "fluid": true,
                "conductivity": 1.0e-12,
                "density": 1.0,
                "specific-heat": 1.0
            }
        },
        "outlet-liquid": {
            "properties": {
                "fluid": true,
                "conductivity": 1.0e-12,
                "density": 2.0,
                "specific-heat": 2.0
            }
        }
    },
    "material-regions": {
        "inlet-side": {
            "material": "inlet-liquid",
            "type": "half-plane",
            "point": [0.47, 0.0],
            "normal": [1.0, 0.0]
        },
        "outlet-side": {"material": "outlet-liquid", "type": "background"}
    },
    "material-region-refinement-level": 10,
    "mesh": {
        "x-axis": {"coarse-grid": [0.0, 1.0], "intervals": [16]},
        "y-axis": {"coarse-grid": [0.0, 1.0], "intervals": [16]}
    },
    "flow-model": {
        "inviscid": true,
        "bc": {
            "inlet": {"type": "velocity", "face-set-ids": [1], "velocity": [1.0, 0.0]},
            "outlet": {"type": "pressure", "face-set-ids": [2], "pressure": 0.0},
            "walls": {"type": "free-slip", "face-set-ids": [3, 4]}
        }
    },
    "ht-model": {
        "bc": {
            "inlet": {"type": "inflow", "face-set-ids": [1],
                      "temp": {"type": "polynomial", "poly-coef": [1.0, 1.0],
                               "poly-powers": [[0, 0, 0], [0, 0, 1]]}},
            "outlet": {"type": "outflow", "face-set-ids": [2]},
            "bottom": {"type": "temperature", "face-set-ids": [3], "temp": 1.0},
            "top": {"type": "temperature", "face-set-ids": [4], "temp": 2.0}
        },
        "source": {}
    },
    "solver": {
        "flow": {
            "courant-number": 0.5,
            "volume-tracking": {"algorithm": "geometric"},
            "projection-solver": {"rel-tol": 1.0e-10, "max-ds-iter": 100, "max-amg-iter": 100}
        },
        "thermal": {
            "preconditioner": {"method": "BoomerAMG", "params": {"num-cycles": 1}},
            "error-norm": {"abs-t-tol": 1.0e-10, "rel-t-tol": 1.0e-4, "rel-h-tol": 1.0e-4},
            "integrator": {"use-backward-euler": true, "nlk-max-iter": 10, "nlk-tol": 0.01}
        },
        "initial-time-step": 1.0e-3,
        "min-time-step": 1.0e-8,
        "max-time-step": 1.0e-3,
        "time-step-growth": 1.05
    },
    "sim-control": {"initial-time": 0.0,
                     "output-times": [0.0025, 0.005, 0.0075, 0.01]},
    "initial-velocity": [1.0, 0.0],
    "initial-temperature": {"type": "polynomial", "poly-coef": [1.0, 1.0], "poly-powers": [[0, 0], [0, 1]]}
}
