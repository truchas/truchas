// Diagnostic case: the noisy hydrostatic water/VOID free surface with the
// nominal interface shifted by half a cell, to y=0.5+1/32. This avoids the
// near-zero fragments of the nominally aligned case.
{
  "materials": {
    "water": {"properties": {"fluid": true, "density": 1.0}}
  },
  "material-regions": {
    "refinement-level": 6,
    "water": {
      "material": "water",
      "type": "box",
      "lower-corner": [0.0, 0.0],
      "upper-corner": [1.0, 0.53125]
    },
    "void-background": {"material": "VOID", "type": "background"}
  },
  "mesh": {
    "x-axis": {"coarse-grid": [0.0, 1.0], "intervals": [16]},
    "y-axis": {"coarse-grid": [0.0, 1.0], "intervals": [16]},
    "noise-factor": 0.1,
    "random-seed": 1
  },
  "flow-model": {
    "inviscid": true,
    "body-acceleration": [0.0, -1.0],
    "bc": {
      "walls": {"type": "free-slip", "face-set-ids": [1, 2, 3, 4]}
    }
  },
  "flow-solver": {
    "projection-solver": {"rel-tol": 1.0e-10, "max-ds-iter": 100, "max-amg-iter": 100}
  },
  "sim-control": {
    "initial-time": 0.0,
    "initial-time-step": 0.1,
    "min-time-step": 1.0e-6,
    "max-time-step": 0.1,
    "output-times": {"times": [0.0, 1.0] }
  },
  "initial-velocity": [0.0, 0.0]
}
