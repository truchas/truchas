// Freely moving unit-speed inviscid plug in a six-cell column.
// Cubic capillary bias comparison; no intermediate output times.
{
  "materials": {
    "water": {"properties": {"fluid": true, "density": 1.0 }}
  },
  "material-regions": {
    "refinement-level": 8,
    "water": {
      "material": "water",
      "type": "box",
      "lower-corner": [ 0.0, 0.75 ],
      "upper-corner": [ 1.0, 3.75 ]
    },
    "void-background": {
      "material": "VOID",
      "type": "background"
    }
  },
  "mesh": {
    "x-axis": { "coarse-grid": [ 0.0, 1.0 ], "intervals": [ 1 ] },
    "y-axis": { "coarse-grid": [ -1.0, 5.0 ], "intervals": [ 6 ] }
  },
  "flow-model": {
    "inviscid": true,
    "void-collapse": {
      "pressure-time-scale": 1.0,
      "reaction-cap": 1000.0,
      "capillary-coefficient": 10.0
    },
    "bc": {
      "bottom": {"type": "pressure", "face-set-ids": [3], "pressure": 0.0},
      "walls": {"type": "free-slip", "face-set-ids": [1,2,4]}
    }
  },
  "flow-solver": {
    "courant-number": 0.125,
    "volume-tracking": {"algorithm": "geometric", "cutoff": 1e-08, "subcycles": 1},
    "projection-solver": {"rel-tol": 1e-12, "max-ds-iter": 100, "max-amg-iter": 100}
  },
  "initial-time": 0.0,
  "output-times": {"times": [0.0, 2.0], "subintervals": [128]},
  "time-stepping": {
    "initial-time-step": 0.015625,
    "min-time-step": 1e-08,
    "max-time-step": 0.015625,
    "time-step-growth": 2.0
  },
  "initial-velocity": [0.0, 1.0]
}
