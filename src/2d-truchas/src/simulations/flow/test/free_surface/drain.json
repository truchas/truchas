// Inviscid water draining from a fluid/VOID pipe at unit speed.
// This is the two-dimensional counterpart to mainline free-surf-flow-2.
{
  "materials": {
    "water": {"properties": {"fluid": true, "density": 1.0}}
  },
  "material-regions": {
    "refinement-level": 0,
    "water": {
      "material": "water",
      "type": "box",
      "lower-corner": [0.0, 0.0],
      "upper-corner": [4.5, 1.0]
    },
    "void-background": {"material": "VOID", "type": "background"}
  },
  "mesh": {
    "x-axis": {"coarse-grid": [0.0, 5.0], "intervals": [15]},
    "y-axis": {"coarse-grid": [0.0, 1.0], "intervals": [5]}
  },
  "flow-model": {
    "inviscid": true,
    "bc": {
      "left": {"type": "velocity", "face-set-ids": [1], "velocity": [-1.0, 0.0]},
      "right": {
        "type": "pressure",
        "face-set-ids": [2],
        "pressure": 0.0,
        "inflow-material": "VOID"
      },
      "walls": {"type": "free-slip", "face-set-ids": [3, 4]}
    }
  },
  "flow-solver": {
    "courant-number": 0.25,
    "volume-tracking": {"algorithm": "geometric", "cutoff": 1.0e-8},
    "projection-solver": {"rel-tol": 1.0e-12, "max-ds-iter": 100, "max-amg-iter": 100}
  },
  "sim-control": {
    "initial-time": 0.0,
    "initial-time-step": 1.0e-2,
    "min-time-step": 1.0e-6,
    "max-time-step": 0.1,
    "time-step-growth": 1.1,
    "output-times": {"times": [1.0, 3.0] }
  },
  "initial-velocity": [-1.0, 0.0]
}
