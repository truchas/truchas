// Inviscid fluid/VOID broken-dam problem in a closed two-dimensional box.
// Initially, water occupies the left half of the box and is released under
// downward gravity.  This is the 2D counterpart of mainline free-surf-flow-4.
{
  "materials": {
    "water": {
      "properties": {
        "fluid": true,
        "density": 1.0
      }
    }
  },
  "material-regions": {
    "refinement-level": 0,
    "water-column": {
      "material": "water",
      "type": "half-plane",
      "point": [0.0, 0.0],
      "normal": [1.0, 0.0]
    },
    "void-background": {
      "material": "VOID",
      "type": "background"
    }
  },
  "mesh": {
    "x-axis": {"coarse-grid": [-0.5, 0.5], "intervals": [20]},
    "y-axis": {"coarse-grid": [-0.5, 0.5], "intervals": [20]}
  },
  "flow-model": {
    "inviscid": true,
    "body-acceleration": [0.0, -1.0],
    "bc": {
      "walls": {"type": "free-slip", "face-set-ids": [1, 2, 3, 4]}
    }
  },
  "flow-solver": {
    "courant-number": 0.25,
    "volume-tracking": {"algorithm": "geometric", "cutoff": 1.0e-6},
    "projection-solver": {"rel-tol": 1.0e-10, "max-ds-iter": 100, "max-amg-iter": 100}
  },
  "sim-control": {
    "initial-time": 0.0,
    "initial-time-step": 1.0e-3,
    "min-time-step": 1.0e-5,
    "max-time-step": 1.0,
    "time-step-growth": 1.05,
    "output-times": [0.1, 0.5, 1.0]
  },
  "initial-velocity": [0.0, 0.0]
}
