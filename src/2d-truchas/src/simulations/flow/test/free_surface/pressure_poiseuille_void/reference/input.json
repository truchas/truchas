// Pressure-driven viscous flow into a fluid/VOID channel.  The channel is
// 2 units long and 1 unit high; water initially fills its first unit and VOID
// occupies the remainder.  The channel walls are no-slip, and body
// acceleration points in the -x direction.  The inlet pressure cycles from
// 1 to 1.3, down to 0.7, and back to 1.0.  The reference regression checks
// the coupled fluid/VOID response through this pressure cycle.  There is no
// exact Poiseuille solution for the complete moving-interface problem.
{
  "materials": {
    "water": {
      "properties": {"fluid": true, "density": 1.0, "viscosity": 0.1}
    }
  },
  "material-regions": {
    "refinement-level": 0,
    "water": {
      "material": "water",
      "type": "box",
      "lower-corner": [0.0, 0.0],
      "upper-corner": [1.0, 1.0]
    },
    "void-background": {"material": "VOID", "type": "background"}
  },
  "mesh": {
    "x-axis": {"coarse-grid": [0.0, 2.0], "intervals": [24]},
    "y-axis": {"coarse-grid": [0.0, 1.0], "intervals": [12]}
  },
  "flow-model": {
    "body-acceleration": [-1.0, 0.0],
    "bc": {
      "inlet": {
        "type": "pressure",
        "face-set-ids": [1],
        "pressure": {
          "type": "tabular",
          "tabular x": [0.0, 2.0, 6.0, 8.0],
          "tabular y": [1.0, 1.3, 0.7, 1.0],
          "interp": "akima"
        },
        "inflow-material": "water"
      },
      "outlet": {
        "type": "pressure",
        "face-set-ids": [2],
        "pressure": 0.0,
        "inflow-material": "VOID"
      },
      "symmetry": {"type": "free-slip", "face-set-ids": [3]},
      "walls": {"type": "no-slip", "face-set-ids": [4]}
    }
  },
  "flow-solver": {
    "courant-number": 0.25,
    "volume-tracking": {"algorithm": "geometric", "cutoff": 1.0e-8},
    "momentum-solver": {"rel-tol": 1.0e-10, "max-ds-iter": 100, "max-amg-iter": 100},
    "projection-solver": {"rel-tol": 1.0e-10, "max-ds-iter": 100, "max-amg-iter": 100}
  },
  "sim-control": {
    "initial-time": 0.0,
    "initial-time-step": 1.0e-2,
    "min-time-step": 1.0e-6,
    "max-time-step": 5.0e-2,
    "time-step-growth": 1.1,
    "output-times": {"times": [3.0, 6.0, 10.0] }
  },
  "initial-velocity": [0.0, 0.0]
}
