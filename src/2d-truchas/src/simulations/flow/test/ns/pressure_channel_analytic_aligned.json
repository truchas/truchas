{
    "materials": {
        "fluid": {"properties": {"fluid": true, "density": 1.0, "viscosity": 1.0}}
    },
    "mesh": {
        "x-axis": {"coarse-grid": [0.0, 1.0], "intervals": [16]},
        "y-axis": {"coarse-grid": [0.0, 1.0], "intervals": [16]}
    },
    "flow-model": {
        "bc": {
            "inlet": {"type": "pressure", "face-set-ids": [1], "pressure": 1.0},
            "outlet": {"type": "pressure", "face-set-ids": [2], "pressure": 0.0},
            "wall": {"type": "no-slip", "face-set-ids": [3, 4]}
        }
    },
    "flow-solver": {
        "momentum-solver": {"rel-tol": 1.0e-10, "max-ds-iter": 100, "max-amg-iter": 100},
        "projection-solver": {"rel-tol": 1.0e-10, "max-ds-iter": 100, "max-amg-iter": 100}
    },
    "initial-velocity": [0.0, 0.0],
    "sim-control": {"initial-time": 0.0, "initial-time-step": 1.0, "min-time-step": 1.0e-6,
        "max-time-step": 1.0, "output-times": [50.0]}
}
