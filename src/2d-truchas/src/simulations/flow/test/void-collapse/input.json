// Nondimensional dam-break flow benchmark of Martin and Moyce.  A 1 by 2
// fluid column initially occupies the left side of a 5 by 3 domain; the
// remainder is VOID.  Gravity acts downward, the walls are free-slip, and
// the top boundary has zero pressure.  This is a long-running example for
// visual and benchmark studies, rather than a routine CTest regression.
{
  "materials": {
    "water": {
      "properties": {
        "fluid": true,
        "density": 1.0,
        "viscosity": 10.0
      }
    }
  },
  "material-regions": {
    "inlet": {
      "material": "water",
      "type": "cell-set", "cell-set-ids": [2]
    },
    "void-background": {
      "material": "VOID",
      "type": "background"
    }
  },
  "mesh": {
    "mesh-file": "mesh.gen"
  },
  "flow-model": {
    "inviscid": false,
    "body-acceleration": [0.0, -100.0],
    "void-collapse": {"model": "mainline", "relaxation": 0.1, "pressure-time-scale": 2.0, "reaction-cap": 100.0},
    "bc": {
      "inlet": {"type": "pressure", "pressure": 180.0, "face-set-ids": [1]},
      "symmetry": {"type": "free-slip", "face-set-ids": [2]},
      "inlet-wall": {"type": "no-slip", "face-set-ids": [4]},
      "walls": {"type": "no-slip", "face-set-ids": [3]}
    }
  },
  "flow-solver": {
    "courant-number": 0.25,
    "volume-tracking": {"algorithm": "geometric", "cutoff": 1.0e-6},
    "projection-solver": {"rel-tol": 1.0e-10, "max-ds-iter": 100, "max-amg-iter": 100},
    "momentum-solver": {"rel-tol": 1.0e-10, "max-ds-iter": 100, "max-amg-iter": 100}
  },
  "initial-time": 0.0,
  "output-times": {"times": [0.0, 7.0], "subintervals": [140]},
  "time-stepping": {
    "initial-time-step": 1.0e-2,
    "min-time-step": 1.0e-6,
    "max-time-step": 1.0,
    "time-step-growth": 1.05
  },
  "initial-velocity": [0.0, 0.0]
}
