{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://truchas.org/schema/flow_thermal_solver_2d.schema.json",
  "title": "Truchas 2D coupled flow-thermal solver",
  "description": "Coupled flow-thermal solver controls. The flow and thermal subobjects configure their respective solves.",
  "type": "object",
  "properties": {
    "flow": {
      "$ref": "../../physics/flow/flow_solver.schema.json",
      "description": "Flow transport and linear-solver controls."
    },
    "thermal": {
      "$ref": "../../physics/thermal/thermal_solver.schema.json",
      "description": "Implicit thermal solver controls."
    }
  },
  "required": ["flow", "thermal"],
  "additionalProperties": false
}
