{
    "materials": {
        "liquid": {
            "properties": {
                "fluid": true,
                "conductivity": 1.0,
                "density": 1.0,
                "specific-heat": 1.0,
                "viscosity": 1.0,
                "thermal-expan-coef": 0.0,
                "expan-ref-temp": 0.0
            }
        }
    },
    "mesh": {
        "x-axis": {"coarse-grid": [0.0, 1.0], "intervals": [16]},
        "y-axis": {"coarse-grid": [0.0, 1.0], "intervals": [16]},
        "rotation-angle": 30.0
    },
    "flow-model": {
        "bc": {
            "inlet": {"type": "pressure", "face-set-ids": [1], "pressure": 1.0},
            "outlet": {"type": "pressure", "face-set-ids": [2], "pressure": 0.0},
            "walls": {"type": "no-slip", "face-set-ids": [3, 4]}
        }
    },
    "ht-model": {
        "bc": {
            "inlet": {
                "type": "inflow",
                "face-set-ids": [1],
                "temp": {"type": "polynomial", "poly-coef": [1.0, -0.5, 0.8660254037844386],
                          "poly-powers": [[0, 0, 0], [0, 1, 0], [0, 0, 1]]}
            },
            "outlet": {"type": "outflow", "face-set-ids": [2]},
            "bottom": {"type": "temperature", "face-set-ids": [3], "temp": 1.0},
            "top": {"type": "temperature", "face-set-ids": [4], "temp": 2.0}
        },
        "source": {}
    },
    "solver": {
        "flow": {
            "courant-number": 0.5,
            "momentum-solver": {"rel-tol": 1.0e-10, "max-ds-iter": 100, "max-amg-iter": 100},
            "projection-solver": {"rel-tol": 1.0e-10, "max-ds-iter": 100, "max-amg-iter": 100}
        },
        "thermal": {
            "preconditioner": {"method": "BoomerAMG", "params": {"num-cycles": 1}},
            "error-norm": {"abs-t-tol": 1.0e-10, "rel-t-tol": 1.0e-6, "rel-h-tol": 1.0e-6},
            "integrator": {"use-backward-euler": true, "nlk-max-iter": 10, "nlk-tol": 0.01}
        },
        "initial-time-step": 1.0e-3,
        "min-time-step": 1.0e-8,
        "max-time-step": 1.0,
        "time-step-growth": 1.05
    },
    "sim-control": {"initial-time": 0.0, "output-times": [50.0]},
    "initial-velocity": [0.0, 0.0],
    "initial-temperature": {
        "type": "polynomial",
        "poly-coef": [1.0, -0.5, 0.8660254037844386],
        "poly-powers": [[0, 0], [1, 0], [0, 1]]
    }
}
