// Single phase-change material with a fluid liquid phase and an immobile
// solid phase.  This first coupled test exercises phase-aware flow mapping,
// enthalpy advection, and thermal phase change with zero body acceleration.
{
  "materials": {
    "phase-change-material": {
      "properties": {
        "conductivity": 1.0e-1,
        "density": 1.0,
        "specific-heat": 1.0,
        "viscosity": 1.0,
        "thermal-expan-coef": 0.0,
        "expan-ref-temp": 0.0
      },
      "phases": {
        "solid": {},
        "liquid": {"fluid": true}
      },
      "phase-changes": {
        "solid:liquid": {
          "solidus-temp": -0.1,
          "liquidus-temp": 0.1,
          "latent-heat": 5.0
        }
      }
    }
  },
  "mesh": {
    "x-axis": {"coarse-grid": [0.0, 1.0], "intervals": [8]},
    "y-axis": {"coarse-grid": [0.0, 1.0], "intervals": [8]}
  },
  "flow-model": {
    "bc": {
      "walls": {"type": "no-slip", "face-set-ids": [1, 2, 3, 4]}
    }
  },
  "ht-model": {
    "bc": {
      "left": {"type": "temperature", "face-set-ids": [1], "temp": -0.5},
      "right": {"type": "temperature", "face-set-ids": [2], "temp": 0.5},
      "top-bottom": {"type": "flux", "face-set-ids": [3, 4], "flux": 0.0}
    },
    "source": {}
  },
  "solver": {
    "flow": {
      "courant-number": 0.5,
      "momentum-solver": {
        "rel-tol": 1.0e-10,
        "abs-tol": 1.0e-12,
        "max-ds-iter": 50,
        "max-amg-iter": 25
      },
      "projection-solver": {
        "rel-tol": 1.0e-10,
        "abs-tol": 1.0e-12,
        "max-ds-iter": 50,
        "max-amg-iter": 25
      }
    },
    "thermal": {
      "preconditioner": {"method": "BoomerAMG", "params": {"num-cycles": 1}},
      "error-norm": {
        "abs-t-tol": 1.0e-4,
        "rel-t-tol": 0.0,
        "abs-h-tol": 1.0e-4,
        "rel-h-tol": 0.0
      },
      "integrator": {
        "use-backward-euler": true,
        "nlk-max-iter": 10,
        "nlk-tol": 1.0e-2
      }
    },
    "initial-time-step": 1.0e-2,
    "min-time-step": 1.0e-6,
    "max-time-step": 2.0e-2,
    "time-step-growth": 1.2
  },
  "sim-control": {
    "initial-time": 0.0,
    "output-times": [0.25, 0.5]
  },
  "initial-temperature": {"type": "constant", "value": 0.5},
  "initial-velocity": [0.0, 0.0]
}
